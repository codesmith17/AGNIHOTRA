<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/widget_bg_warm"
                android:centerColor="@color/widget_bg_mid"
                android:endColor="@color/widget_bg_dark" />
            <stroke
                android:width="1dp"
                android:color="#88E7A45A" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:drawable="@drawable/agni_widget_logo"
        android:gravity="center" />
</layer-list>
