<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/widget_sunset_start"
                android:centerColor="@color/widget_sunset_mid"
                android:endColor="@color/widget_sunset_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_sunset_stroke" />
        </shape>
    </item>
</layer-list>
