<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/launcher_gold_start"
                android:centerColor="@color/launcher_gold_mid"
                android:endColor="@color/launcher_gold_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E69500" />
        </shape>
    </item>
</layer-list>
