<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Sunset: sun as a half dome sinking onto the waterline, with reflection -->
    <!-- short downward-tilted rays (lower, calmer than sunrise) -->
    <path
        android:strokeColor="@color/widget_ink"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M12,3.0 V4.8 M5.0,6.2 L6.4,7.2 M19.0,6.2 L17.6,7.2 M2.6,11.0 H4.2 M21.4,11.0 H19.8" />

    <!-- half-sun dome resting on the horizon -->
    <path
        android:strokeColor="@color/widget_ink"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M8.0,13.0 A4,4 0 0 1 16,13.0" />

    <!-- sea horizon -->
    <path
        android:strokeColor="@color/widget_ink"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M2.4,13.0 H21.6" />

    <!-- reflection shimmer on the water -->
    <path
        android:strokeColor="@color/widget_ink"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M9.2,16.2 H14.8 M10.4,18.6 H13.6 M11.4,20.8 H12.6" />
</vector>
