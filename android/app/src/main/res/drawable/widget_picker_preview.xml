<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/launcher_gold_start"
                android:centerColor="@color/launcher_gold_mid"
                android:endColor="@color/launcher_gold_end" />
            <stroke
                android:width="1.5dp"
                android:color="#E69500" />
            <size
                android:width="110dp"
                android:height="110dp" />
        </shape>
    </item>

    <item
        android:width="22dp"
        android:height="22dp"
        android:drawable="@drawable/ic_widget_sun"
        android:gravity="top|center_horizontal"
        android:top="20dp" />

    <item
        android:width="52dp"
        android:height="5dp"
        android:gravity="top|center_horizontal"
        android:top="48dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/widget_ink" />
        </shape>
    </item>

    <item
        android:width="64dp"
        android:height="12dp"
        android:gravity="center"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/widget_ink" />
        </shape>
    </item>

    <item
        android:width="36dp"
        android:height="5dp"
        android:gravity="bottom|center_horizontal"
        android:bottom="22dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/widget_ink_soft" />
        </shape>
    </item>
</layer-list>
