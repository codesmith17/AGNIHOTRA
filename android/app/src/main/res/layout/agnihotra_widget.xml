<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_event_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_widget_sun"
        android:contentDescription="@string/widget_event_icon_desc"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_event_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_no_timing"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="--"
        android:textColor="@color/widget_ink"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="1" />

    <Chronometer
        android:id="@+id/widget_countdown_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_ink"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_event_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="--"
        android:textColor="@color/widget_ink_soft"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:maxLines="1"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/widget_event_icon_wrap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_event_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@string/widget_logo_desc" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_countdown_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
