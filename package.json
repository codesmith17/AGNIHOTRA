{
  "name": "eternal-agni-agnihotra",
  "version": "1.0.7",
  "description": "EternalAgni Agnihotra timing app with precise sunrise/sunset times",
  "main": "index.html",
  "scripts": {
    "postinstall": "patch-package",
    "build": "node build.js",
    "start": "node cors-proxy.js",
    "dev": "nodemon cors-proxy.js",
    "cap:copy": "npm run build && npx cap copy",
    "cap:sync": "npm run build && npx cap sync",
    "assets:android": "npx @capacitor/assets generate --android --assetPath resources",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "ota:pack": "npm run build && node scripts/ota-pack.js",
    "ota:release": "npm run ota:pack && node scripts/ota-release.js"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.0",
    "@capacitor-community/native-audio": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-updater": "^8.47.5",
    "capacitor-email-composer": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "nodemon": "^3.0.1",
    "patch-package": "^8.0.1"
  },
  "keywords": [
    "agnihotra",
    "cors",
    "proxy",
    "sunrise",
    "sunset",
    "static-site"
  ],
  "author": "EternalAgni",
  "license": "MIT"
}
